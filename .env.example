# ==========================================
# ATS 3.0 Web Application - Environment Config
# Copy this file to .env.local and fill in your actual credentials.
# ==========================================

# Database Connection (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
DB_SCHEMA=sandbox # Use 'sandbox' for isolated dev/testing, or 'public' for production

# NextAuth Authentication & Google SSO
AUTH_SECRET="your-32-character-random-auth-secret-string"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"
ALLOWED_EMAILS="admin@example.com,recruiter@example.com"

# Security & Data Encryption (AES-256-GCM)
# Generate a secure 32+ character key for encrypting sensitive fields (proxies, 2FA notes)
APP_ENCRYPTION_SECRET="your-app-encryption-secret-key-at-least-32-chars"

# Internal Webhook Shared Secret (Header: x-internal-secret)
# Used to authenticate webhooks communicating between Next.js and automation workers
INTERNAL_WEBHOOK_SECRET="your-random-sha256-internal-secret-token"

# n8n Automation Webhooks & Forms
NEXT_PUBLIC_N8N_CV_PARSER_FORM_URL="https://your-n8n-instance.com/form/your-form-id"
N8N_CV_UPLOAD_WEBHOOK_URL="https://your-n8n-instance.com/webhook/cv-upload"
N8N_RENAME_WEBHOOK_URL="https://your-n8n-instance.com/webhook/rename-drive-file"
N8N_CAMPAIGN_TRIGGER_WEBHOOK_URL="https://your-n8n-instance.com/webhook/campaign-trigger"
N8N_WARM_JOIN_TRIGGER_WEBHOOK_URL="https://your-n8n-instance.com/webhook/warm-join-trigger"

# Optional Tuning
SAFE_DISPATCH_BATCH_SIZE=18
